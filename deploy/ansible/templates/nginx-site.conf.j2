# Managed by Ansible. Do not edit by hand.
# Host nginx terminates TLS and forwards to the compose loopback listeners.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ ([nginx_server_name] + nginx_server_aliases) | join(' ') }};

    # The application treats nginx_server_name as its only canonical origin.
    return 301 https://{{ nginx_server_name }}$request_uri;
}

# Keep the port used by the previous site, but make 443 the only app origin.
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name {{ ([nginx_server_name] + nginx_server_aliases) | join(' ') }};

    ssl_certificate {{ nginx_ssl_certificate }};
    ssl_certificate_key {{ nginx_ssl_certificate_key }};
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://{{ nginx_server_name }}$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ ([nginx_server_name] + nginx_server_aliases) | join(' ') }};

    ssl_certificate {{ nginx_ssl_certificate }};
    ssl_certificate_key {{ nginx_ssl_certificate_key }};
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

{% for alias in nginx_server_aliases %}
    if ($host = {{ alias }}) {
        return 301 https://{{ nginx_server_name }}$request_uri;
    }
{% endfor %}

    client_max_body_size {{ nginx_client_max_body_size }};

    # The browser-facing /v1 integration endpoint stays closed.
    location = /v1 {
        return 404;
    }

    location ^~ /v1/ {
        return 404;
    }

    location = /admin {
        return 301 /admin/;
    }

    # Admin UI and its same-origin API.
    location ^~ /admin/ {
        proxy_pass {{ nginx_admin_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-OpenWebUI-User-JWT "";
        proxy_set_header X-OpenWebUI-Chat-Id "";
        proxy_set_header X-OpenWebUI-User-Id "";
        proxy_set_header X-OpenWebUI-User-Role "";
        proxy_redirect off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Open WebUI chat and websocket traffic.
    location / {
        proxy_pass {{ nginx_chat_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-OpenWebUI-User-JWT "";
        proxy_set_header X-OpenWebUI-Chat-Id "";
        proxy_set_header X-OpenWebUI-User-Id "";
        proxy_set_header X-OpenWebUI-User-Role "";
        proxy_redirect off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
